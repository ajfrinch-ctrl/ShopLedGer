{
  "name": "shopledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "BASE_PATH=/ShopLedGer/ tsc -b && BASE_PATH=/ShopLedGer/ vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:ui-design": "node --test tests/ui-design.test.mjs",
    "test:ui": "node tests/ui-smoke.build.mjs && node --import ./tests/ui-smoke.preload.mjs node_modules/.cache/ui-smoke.mjs",
    "test:ui-sales": "node tests/ui-smoke.sales.build.mjs && node --import ./tests/ui-smoke.preload.mjs node_modules/.cache/ui-smoke-sales.mjs",
    "test:ui-shortcuts": "node tests/ui-smoke.shortcuts.build.mjs && node --import ./tests/ui-smoke.preload.mjs node_modules/.cache/ui-smoke-shortcuts.mjs",
    "icons:shortcuts": "node scripts/generate-shortcut-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.1.0"
  }
}
